/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Hashed build output: the file name changes whenever the content does, so it can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Coastlines and bundled datasets never change in place. If one is ever replaced, give it a new name.
# (gmt.js, gmt.wasm and manifest.json are deliberately NOT here: they must always match each other, so they keep
# Cloudflare's default "revalidate on every visit", which costs a tiny "not modified" answer.)
/gmt/data/*
  Cache-Control: public, max-age=604800
/gmt/remote/*
  Cache-Control: public, max-age=604800
